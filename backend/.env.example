# Copy to `.env` and adjust. The application reads variables from this file
# automatically when run with `uvicorn app.main:app`.

# SQLAlchemy URL. SQLite is used by default for zero-setup local development;
# switch to Postgres in production / when running `docker compose up`.
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/vega

# Allowed CORS origins. Accepts either a comma-separated list or a JSON array,
# e.g. `http://localhost:5173,https://example.com` or `["http://localhost:5173"]`.
CORS_ORIGINS=http://localhost:5173

# JWT signing secret. The default below is fine for local dev; production
# deployments MUST set this to a long random string (e.g. `python -c "import
# secrets; print(secrets.token_urlsafe(64))"`).
JWT_SECRET=dev-jwt-secret-do-not-use-in-prod
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
